# =================================================================
# ARCVAULT — ENVIRONMENT CONFIGURATION
# =================================================================
# Duplicate this file as .env and populate with your production keys.
# All variables are prefixed with VITE_ so they are accessible in client code.

# -----------------------------------------------------------------
# 1. APP CONFIGURATION
# -----------------------------------------------------------------
VITE_APP_NAME="ARCVAULT"
VITE_APP_DESCRIPTION="Curated Digital Art & On-Chain Ownership Platform"
VITE_APP_URL="https://arcvault.art"

# -----------------------------------------------------------------
# 2. WALLETCONNECT & REOWN PROJECT ID
# -----------------------------------------------------------------
# Get your free Project ID at: https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID="3a8170812b534d0ff9d794f168fa48e6"

# -----------------------------------------------------------------
# 3. RPC PROVIDERS (Alchemy, Infura, QuickNode)
# -----------------------------------------------------------------
# Optional: Add your Alchemy or Infura keys for dedicated high-speed node access
VITE_ALCHEMY_API_KEY=""
VITE_INFURA_API_KEY=""

# Custom RPC Endpoints (defaults to reliable public RPCs)
VITE_ETH_RPC_URL="https://eth.llamarpc.com"
VITE_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
VITE_BASE_RPC_URL="https://mainnet.base.org"
VITE_ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
VITE_POLYGON_RPC_URL="https://polygon-rpc.com"

# -----------------------------------------------------------------
# 4. DECENTRALIZED STORAGE / IPFS (Pinata or Web3.Storage)
# -----------------------------------------------------------------
# Get API keys at: https://app.pinata.cloud/keys
VITE_PINATA_API_KEY=""
VITE_PINATA_SECRET_KEY=""
VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# -----------------------------------------------------------------
# 5. SMART CONTRACT ADDRESSES
# -----------------------------------------------------------------
VITE_CONTRACT_MAINNET="0x82f9A1394C01e0D642aFE5698b6a12C57B4A491A"
VITE_CONTRACT_SEPOLIA="0x73a812D9eBc29B120c8aF460cE518104E90B0C21"
VITE_CONTRACT_BASE="0x19fB234901CaD730f06B6282E2E675fC5E48bB82"
VITE_ROYALTY_PERCENTAGE="7.5"
